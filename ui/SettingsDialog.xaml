<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="640" Height="500" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        FontFamily="Tahoma" FontSize="11" Background="White"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="#DCEBFA"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>
        <Style x:Key="SectionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4A7FB5"/>
        </Style>
        <Style x:Key="Num" TargetType="TextBox">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#C9C9C9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NumBtn" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#F4F4F4"/>
            <Setter Property="BorderBrush" Value="#C9C9C9"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="Info" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="#2F7FD0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Text" Value="&#xE946;"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="135"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="#D0D0D0" BorderThickness="0,0,1,0" Background="White">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="4,6,4,4">
                    <TextBox x:Name="txtFind" Style="{StaticResource SearchBox}"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#9AA3AD" FontSize="11" IsHitTestVisible="False" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="phFind" Text="Найти настройки" Foreground="#A0A0A0" IsHitTestVisible="False" Margin="20,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel DockPanel.Dock="Bottom" Margin="6,6,6,8">
                    <CheckBox x:Name="chkAdvanced" Content="Расширенные настройки" Margin="2,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnOk" Content="OK" Style="{StaticResource PrimaryButton}" Width="58" Margin="0" IsDefault="True"/>
                        <Button x:Name="btnCancel" Content="Отмена" Style="{StaticResource DialogButton}" Width="58" MinWidth="58" IsCancel="True"/>
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="lbPages" BorderThickness="0" ItemContainerStyle="{StaticResource SideListItem}" ItemTemplate="{StaticResource SideItemTemplate}"/>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,10,10">
                <!-- ==================== Общие ==================== -->
                <StackPanel x:Name="pageGeneral">
                    <Border Style="{StaticResource Section}"><TextBlock Text="Региональные настройки" Style="{StaticResource SectionText}"/></Border>
                    <TextBlock Text="Язык приложения:" Margin="14,4,0,4"/>
                    <ComboBox x:Name="cbLanguage" Width="120" HorizontalAlignment="Left" Margin="34,0,0,8" IsEnabled="False">
                        <ComboBoxItem Content="Русский" IsSelected="True"/>
                    </ComboBox>
                    <Rectangle Height="1" Stroke="#C9C9C9" StrokeDashArray="2 2" Margin="0,4,0,8" SnapsToDevicePixels="True"/>
                    <TextBlock Text="Первый день недели:" Margin="14,0,0,4"/>
                    <ComboBox x:Name="cbFirstDay" Width="120" HorizontalAlignment="Left" Margin="34,0,0,8">
                        <ComboBoxItem Content="воскресенье"/>
                        <ComboBoxItem Content="понедельник"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Margin="14,2,0,2">
                        <CheckBox x:Name="chkRelativeDates" Content="Использовать относительные даты"/>
                        <TextBlock Style="{StaticResource Info}" ToolTip="Показывать «Сегодня» и «Вчера» вместо даты"/>
                    </StackPanel>
                    <CheckBox x:Name="chkCustomDate" Content="Пользовательский формат даты" Margin="14,2,0,4"/>
                    <TextBox x:Name="txtDateFormat" Width="110" HorizontalAlignment="Left" Margin="34,0,0,2" Height="20"/>
                    <TextBlock x:Name="txtDatePreview" Foreground="#A0A0A0" Margin="34,2,0,2"/>
                    <TextBlock Foreground="#A0A0A0" Margin="34,0,0,2" TextWrapping="Wrap" Text="d — день, MM — месяц, MMM — сокращённый месяц, yyyy — год"/>

                    <Border Style="{StaticResource Section}"><TextBlock Text="Хранилище" Style="{StaticResource SectionText}"/></Border>
                    <TextBlock Text="Папка хранилища:" Margin="14,0,0,4"/>
                    <DockPanel Margin="34,0,0,4">
                        <Button x:Name="btnBrowseStorage" DockPanel.Dock="Right" Content="Обзор..." Style="{StaticResource DialogButton}" MinWidth="70"/>
                        <TextBox x:Name="txtStoragePath" Height="22" IsReadOnly="True" Background="#F7F7F7"/>
                    </DockPanel>
                </StackPanel>

                <!-- ==================== Сканер ==================== -->
                <StackPanel x:Name="pageScanner" Visibility="Collapsed">
                    <Border Style="{StaticResource Section}"><TextBlock Text="Общие настройки сканирования" Style="{StaticResource SectionText}"/></Border>
                    <CheckBox x:Name="chkSkipExisting" Content="Пропускать существующие устройства" Margin="14,2,0,2"/>
                    <StackPanel Orientation="Horizontal" Margin="34,2,0,4">
                        <TextBlock Text="если они сканировались менее, чем" Foreground="#888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="numSkipHoursDec" Content="&#x2212;" Style="{StaticResource NumBtn}"/>
                        <TextBox x:Name="numSkipHours" Style="{StaticResource Num}"/>
                        <Button x:Name="numSkipHoursInc" Content="+" Style="{StaticResource NumBtn}"/>
                        <TextBlock Text="часа(ов) назад" Foreground="#888" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="pnlThreads" Orientation="Horizontal" Margin="14,4,0,4">
                        <TextBlock Text="Одновременно сканировать устройств:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="numThreadsDec" Content="&#x2212;" Style="{StaticResource NumBtn}"/>
                        <TextBox x:Name="numThreads" Style="{StaticResource Num}"/>
                        <Button x:Name="numThreadsInc" Content="+" Style="{StaticResource NumBtn}"/>
                    </StackPanel>

                    <Border Style="{StaticResource Section}"><TextBlock Text="Настройки сетевого обнаружения" Style="{StaticResource SectionText}"/></Border>
                    <StackPanel Orientation="Horizontal" Margin="14,2,0,6">
                        <CheckBox x:Name="chkDiscovery" Content="Использовать сетевое обнаружение"/>
                        <TextBlock Style="{StaticResource Info}" ToolTip="Перед сбором данных проверять доступность узла (пинг, ARP, порты). Без обнаружения сбор выполняется для каждого адреса."/>
                    </StackPanel>
                    <StackPanel x:Name="pnlDiscovery" Margin="30,0,0,0">
                        <TextBlock Text="Метод обнаружения устройств" Margin="0,2,0,4"/>
                        <Grid Margin="16,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                            <TextBlock Text="Количество попыток" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="numAttemptsDec" Content="&#x2212;" Style="{StaticResource NumBtn}"/>
                                <TextBox x:Name="numAttempts" Style="{StaticResource Num}"/>
                                <Button x:Name="numAttemptsInc" Content="+" Style="{StaticResource NumBtn}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Тайм-аут" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="numPingTimeoutDec" Content="&#x2212;" Style="{StaticResource NumBtn}"/>
                                <TextBox x:Name="numPingTimeout" Style="{StaticResource Num}"/>
                                <Button x:Name="numPingTimeoutInc" Content="+" Style="{StaticResource NumBtn}"/>
                                <TextBlock Text="мс" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Профиль обнаружения устройств" Margin="16,4,0,4"/>
                        <StackPanel Margin="34,0,0,4">
                            <StackPanel Orientation="Horizontal" Margin="0,1"><RadioButton x:Name="rbFast" GroupName="prof" Content="Быстрый (поверхностный)"/><TextBlock Style="{StaticResource Info}" ToolTip="Только пинг"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1"><RadioButton x:Name="rbNormal" GroupName="prof" Content="Обычный"/><TextBlock Style="{StaticResource Info}" ToolTip="Пинг и проверка портов"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1"><RadioButton x:Name="rbSlow" GroupName="prof" Content="Медленный (тщательный)"/><TextBlock Style="{StaticResource Info}" ToolTip="Дополнительная попытка пинга, ARP и расширенный набор портов"/></StackPanel>
                        </StackPanel>
                        <TextBlock Text="Общие настройки пингования" Margin="16,4,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="34,0,0,4">
                            <CheckBox x:Name="chkArp" Content="Использовать ARP ping"/>
                            <TextBlock Style="{StaticResource Info}" ToolTip="Находит устройства в той же подсети, даже если они не отвечают на пинг"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource Section}"><TextBlock Text="Настройки сканирования портов" Style="{StaticResource SectionText}"/></Border>
                    <TextBlock Text="Метод сканирования портов" Margin="14,2,0,4"/>
                    <StackPanel Margin="30,0,0,4">
                        <StackPanel Orientation="Horizontal" Margin="0,1"><RadioButton x:Name="rbSafe" GroupName="ports" Content="Безопасный профиль: проверять 3 порта, требуемых для сканирования"/><TextBlock Style="{StaticResource Info}" ToolTip="135, 445, 5985"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1"><RadioButton x:Name="rbLight" GroupName="ports" Content="Легкий профиль: проверять 10 наиболее часто открытых портов"/><TextBlock Style="{StaticResource Info}" ToolTip="135, 139, 445, 5985, 5986, 22, 80, 443, 3389, 9100"/></StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="30,2,0,4">
                        <TextBlock Text="Тайм-аут" VerticalAlignment="Center" Width="140"/>
                        <Button x:Name="numPortTimeoutDec" Content="&#x2212;" Style="{StaticResource NumBtn}"/>
                        <TextBox x:Name="numPortTimeout" Style="{StaticResource Num}"/>
                        <Button x:Name="numPortTimeoutInc" Content="+" Style="{StaticResource NumBtn}"/>
                        <TextBlock Text="мс" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <Border Style="{StaticResource Section}"><TextBlock Text="Настройки сканирования" Style="{StaticResource SectionText}"/></Border>
                    <StackPanel Orientation="Horizontal" Margin="14,2,0,2">
                        <CheckBox x:Name="chkDisableDcom" Content="Отключить протокол RPC (DCOM) для сканирования Windows-компьютеров"/>
                        <TextBlock Style="{StaticResource Info}" ToolTip="Использовать только WinRM (PowerShell Remoting)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="14,2,0,2">
                        <CheckBox x:Name="chkScanUpdates" Content="Включить сканирование журнала обновлений Windows"/>
                        <TextBlock Style="{StaticResource Info}" ToolTip="Сбор истории Центра обновления Windows"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="34,2,0,2">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#E0A526" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="При сканировании по протоколу RPC информация об обновлениях не собирается." Foreground="#A0A0A0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="34,2,0,6">
                        <TextBlock Text="Тайм-аут получения информации об обновлениях" Foreground="#888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="numUpdTimeoutDec" Content="&#x2212;" Style="{StaticResource NumBtn}"/>
                        <TextBox x:Name="numUpdTimeout" Style="{StaticResource Num}"/>
                        <Button x:Name="numUpdTimeoutInc" Content="+" Style="{StaticResource NumBtn}"/>
                        <TextBlock Text="мин." Foreground="#888" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- ==================== Отчеты ==================== -->
                <StackPanel x:Name="pageReports" Visibility="Collapsed">
                    <Border Style="{StaticResource Section}"><TextBlock Text="Просмотр устройства" Style="{StaticResource SectionText}"/></Border>
                    <CheckBox x:Name="chkShowEmpty" Content="Показывать пустые значения" Margin="14,2,0,6"/>
                    <Border Style="{StaticResource Section}"><TextBlock Text="Запрещенное ПО" Style="{StaticResource SectionText}"/></Border>
                    <TextBlock Text="Шаблоны названий (по одному в строке, допускаются * и ?):" Margin="14,0,0,4"/>
                    <TextBox x:Name="txtForbidden" Margin="14,0,0,4" Height="110" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextWrapping="NoWrap"/>
                    <TextBlock Text="Используется шаблоном «Запрещенное ПО» на вкладке «Табличные отчеты»." Foreground="#888" Margin="14,0,0,4"/>
                </StackPanel>

                <!-- ==================== Сигналы ==================== -->
                <StackPanel x:Name="pageAlerts" Visibility="Collapsed">
                    <Border Style="{StaticResource Section}"><TextBlock Text="Условия сигналов" Style="{StaticResource SectionText}"/></Border>
                    <StackPanel Orientation="Horizontal" Margin="14,2,0,4">
                        <TextBlock Text="Мало места на диске, если свободно менее" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="numDiskFreeDec" Content="&#x2212;" Style="{StaticResource NumBtn}"/>
                        <TextBox x:Name="numDiskFree" Style="{StaticResource Num}"/>
                        <Button x:Name="numDiskFreeInc" Content="+" Style="{StaticResource NumBtn}"/>
                        <TextBlock Text="%" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="14,2,0,4">
                        <TextBlock Text="Мало оперативной памяти, если менее" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="numMinRamDec" Content="&#x2212;" Style="{StaticResource NumBtn}"/>
                        <TextBox x:Name="numMinRam" Style="{StaticResource Num}"/>
                        <Button x:Name="numMinRamInc" Content="+" Style="{StaticResource NumBtn}"/>
                        <TextBlock Text="ГБ" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="chkAlertAv" Content="Проблемы с антивирусом (нет, отключен, устаревшие базы)" Margin="14,4,0,2"/>
                    <CheckBox x:Name="chkAlertFw" Content="Выключенный брандмауэр" Margin="14,2,0,2"/>
                    <CheckBox x:Name="chkAlertDevices" Content="Устройства с ошибками" Margin="14,2,0,2"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
