<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Укажите логины с правами администратора" Width="470" Height="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Tahoma" FontSize="11" Background="White"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <!-- Windows -->
        <StackPanel Grid.Row="0">
            <Border Background="#DCEBFA" Padding="8,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE782;" FontFamily="Segoe MDL2 Assets" Foreground="#1E88E5" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Windows" FontWeight="Bold" Foreground="#2F7FD0"/>
                        <TextBlock Text="Логин для сканирования Windows-компьютеров" Foreground="#4A7FB5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Margin="16,10,16,6">
                <RadioButton x:Name="rbCurrent" GroupName="win" Content="Текущий пользователь" Margin="0,0,0,4"/>
                <TextBlock x:Name="txtCurrentUser" Foreground="#888" Margin="20,0,0,6"/>
                <RadioButton x:Name="rbSpecify" GroupName="win" Content="Указать (сохранённый логин)" Margin="0,0,0,6"/>
            </StackPanel>
        </StackPanel>
        <!-- сохранённые логины -->
        <Grid Grid.Row="1" Margin="34,0,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="lbLogins" BorderBrush="#C9C9C9" ItemContainerStyle="{StaticResource SideListItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Height="20">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#2B7CD3" VerticalAlignment="Center" Margin="4,0,6,0"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <Button x:Name="btnAddLogin" Content="Добавить..." Style="{StaticResource DialogButton}" Margin="0,0,0,4"/>
                <Button x:Name="btnEditLogin" Content="Изменить..." Style="{StaticResource DialogButton}" Margin="0,0,0,4"/>
                <Button x:Name="btnDeleteLogin" Content="Удалить" Style="{StaticResource DialogButton}" Margin="0"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="#EAF3FC" Padding="10,6" BorderBrush="#D4E6F7" BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock Text="Выбранный логин используется по умолчанию для новых задач; для каждой задачи его можно изменить в таблице задач." Foreground="#4A7FB5" TextWrapping="Wrap"/>
                <TextBlock Text="Пароли хранятся в зашифрованном виде (DPAPI, только для текущего пользователя Windows)." Foreground="#4A7FB5" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
            <Button x:Name="btnOk" Content="OK" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
            <Button x:Name="btnCancel" Content="Отмена" Style="{StaticResource DialogButton}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
