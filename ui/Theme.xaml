<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Цвета ===================== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2F7FD0"/>
    <SolidColorBrush x:Key="KeyBrush" Color="#2F7FD0"/>
    <SolidColorBrush x:Key="LineBrush" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="ToolbarBrush" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="SideBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="EmptyBrush" Color="#EBEBEB"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E5F1FB"/>
    <SolidColorBrush x:Key="SelectBrush" Color="#CDE6F7"/>
    <SolidColorBrush x:Key="SelectBorderBrush" Color="#7EB4EA"/>
    <SolidColorBrush x:Key="RowHighlightBrush" Color="#FFF5B0"/>
    <SolidColorBrush x:Key="GrayTextBrush" Color="#808080"/>
    <FontFamily x:Key="GlyphFont">Segoe MDL2 Assets</FontFamily>

    <!-- ===================== Текст ===================== -->
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SideHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#6D7783"/>
        <Setter Property="Margin" Value="6,10,6,4"/>
    </Style>
    <Style x:Key="EmptyTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#8A8A8A"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,18,0,6"/>
    </Style>
    <Style x:Key="EmptyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#666666"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ===================== Кнопки ===================== -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5,2"/>
        <Setter Property="Foreground" Value="#222222"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E5F1FB"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#CCE4F7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CCE4F7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Foreground" Value="#2F7FD0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="T" Background="Transparent" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Строка-ссылка на боковой панели (иконка + текст) -->
    <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="10,2,4,2"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- Кнопка с рамкой на боковой панели («Настроить сканер», «Подключиться к домену») -->
    <Style x:Key="PanelButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#C9C9C9"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Margin" Value="6,2,6,0"/>
    </Style>

    <!-- Обычная кнопка диалога -->
    <Style x:Key="DialogButton" TargetType="Button">
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="Background" Value="#FDFDFD"/>
        <Setter Property="BorderBrush" Value="#ADADAD"/>
        <Setter Property="Foreground" Value="#222222"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="10,0" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E5F1FB"/><Setter TargetName="Bd" Property="BorderBrush" Value="#0078D7"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
        <Setter Property="Background" Value="#3D9AE8"/>
        <Setter Property="BorderBrush" Value="#2F86D2"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="10,0" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#2F86D2"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Вкладки главного окна -->
    <Style x:Key="MainTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#222222"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1,0,1,0" Padding="12,0,14,0" Margin="0,2,0,-1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Top" Height="2" VerticalAlignment="Top" Margin="0,2,0,0" Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E9F2FB"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#CFCFCF"/>
                            <Setter TargetName="Top" Property="Background" Value="#9CC8F0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Поля ввода ===================== -->
    <Style TargetType="TextBox">
        <Setter Property="BorderBrush" Value="#C9C9C9"/>
        <Setter Property="Padding" Value="2,1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="BorderBrush" Value="#C9C9C9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18,1,2,1"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="BorderBrush" Value="#C9C9C9"/>
        <Setter Property="Padding" Value="2,1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- ===================== Таблицы ===================== -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#ECECEC"/>
        <Setter Property="VerticalGridLinesBrush" Value="#ECECEC"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="RowHeight" Value="20"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#FAFAFA"/>
        <Setter Property="Foreground" Value="#555555"/>
        <Setter Property="BorderBrush" Value="#DEDEDE"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="22"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#FFF5B0"/>
                <Setter Property="Foreground" Value="#000000"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFFBE0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Списки ===================== -->
    <Style x:Key="PlainListItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FFFBE0"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FFF5B0"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SideListItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="6,0,6,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EEF6FD"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#CDE6F7"/><Setter TargetName="Bd" Property="BorderBrush" Value="#7EB4EA"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Элемент боковой панели: пункт / заголовок / папка / разделитель -->
    <DataTemplate x:Key="SideItemTemplate">
        <Grid Margin="{Binding IndentMargin}" Visibility="{Binding VisibilityText}">
            <Grid x:Name="item" MinHeight="19">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphColor}" Style="{StaticResource Glyph}" FontSize="13" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="{Binding CountColor}" VerticalAlignment="Center" Margin="4,0,4,0"/>
            </Grid>
            <Grid x:Name="header" Visibility="Collapsed" Height="22">
                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#6D7783" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding Arrow}" Foreground="#6D7783" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,4"/>
            </Grid>
            <Grid x:Name="folder" Visibility="Collapsed" Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8B7;" Foreground="#E0A526" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" Foreground="#3A6EA5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <Border x:Name="sep" Visibility="Collapsed" Height="9">
                <Border Height="1" Background="#DDDDDD" VerticalAlignment="Center"/>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Header">
                <Setter TargetName="item" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="header" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Folder">
                <Setter TargetName="item" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="folder" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Separator">
                <Setter TargetName="item" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="sep" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Элемент боковой панели с флажком (журнал изменений) -->
    <DataTemplate x:Key="SideCheckTemplate">
        <Grid Margin="{Binding IndentMargin}" Visibility="{Binding VisibilityText}">
            <Grid x:Name="item" Height="19">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Tag="{Binding}"/>
                <TextBlock Grid.Column="1" Text="{Binding Glyph}" Foreground="{Binding GlyphColor}" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="{Binding Count}" Foreground="#666666" VerticalAlignment="Center" Margin="4,0,6,0"/>
            </Grid>
            <Grid x:Name="header" Visibility="Collapsed" Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="False" VerticalAlignment="Center" Tag="{Binding}"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" Foreground="#6D7783" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Arrow}" Foreground="#6D7783" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Header">
                <Setter TargetName="item" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="header" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Кнопка-раскрыватель дерева (квадрат с плюсом/минусом) -->
    <Style x:Key="TreeExpander" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Width="16" Height="16">
                        <Border Width="9" Height="9" BorderBrush="#8E9AA6" BorderThickness="1" Background="White" SnapsToDevicePixels="True">
                            <Grid>
                                <Rectangle Width="5" Height="1" Fill="#3A4A5A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Rectangle x:Name="V" Width="1" Height="5" Fill="#3A4A5A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="V" Property="Visibility" Value="Collapsed"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Элемент дерева хранилища: строка на всю ширину -->
    <Style x:Key="StorageTreeItem" TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
        <Setter Property="Visibility" Value="{Binding VisibilityText}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                            <Grid Margin="{Binding DepthMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander" Style="{StaticResource TreeExpander}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EEF6FD"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CDE6F7"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#7EB4EA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
</ResourceDictionary>
