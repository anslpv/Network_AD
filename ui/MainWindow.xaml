<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Inventory" Width="1400" Height="860" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#FFFFFF"
        FontFamily="Tahoma" FontSize="11" Foreground="#222222"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <!-- ===================== Верхняя строка ===================== -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E1E1E1" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="2,0,0,0">
                    <Button x:Name="btnStorageMenu" Style="{StaticResource FlatButton}" ToolTip="Хранилище">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" Style="{StaticResource Glyph}" Foreground="#5A6E83" Margin="0,0,5,0"/>
                            <TextBlock Text="Хранилище"/>
                            <TextBlock Text=" &#x25BE;" Foreground="#555"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="txtStoragePath" Foreground="#999999" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0">
                    <Button x:Name="btnInventoryMenu" Style="{StaticResource FlatButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" Foreground="#2E9E3E" Margin="0,0,5,0" FontSize="12"/>
                            <TextBlock Text="Инвентаризация"/>
                            <TextBlock Text=" &#x25BE;" Foreground="#555"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnSettings" Style="{StaticResource FlatButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Foreground="#5F6B76" Margin="0,0,5,0" FontSize="12"/>
                            <TextBlock Text="Настройки"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnHelpMenu" Style="{StaticResource FlatButton}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="15" Height="15" CornerRadius="8" Background="#2F7FD0">
                                <TextBlock Text="?" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text=" &#x25BE;" Foreground="#555"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid/>
            </DockPanel>
        </Border>

        <!-- ===================== Основная область ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colLeft" Width="225" MinWidth="160"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Левая панель: хранилище ============ -->
            <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0" Background="#FFFFFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="#E1E1E1" BorderThickness="0,0,0,1">
                        <Grid Margin="4,0,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center">
                                <TextBox x:Name="txtTreeSearch" BorderThickness="0" Padding="18,1,2,1" Background="Transparent"/>
                                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="#7A8A99" FontSize="11" IsHitTestVisible="False" Margin="2,0,0,0" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="phTreeSearch" Text="Поиск..." Foreground="#A0A0A0" IsHitTestVisible="False" Margin="20,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <Button x:Name="btnTreeSort" Grid.Column="1" Style="{StaticResource FlatButton}" Padding="2,0" ToolTip="Сортировка: по имени / по IP-адресу">
                                <TextBlock x:Name="txtTreeSort" Text="A&#x2193;" FontSize="10" Foreground="#555"/>
                            </Button>
                            <Button x:Name="btnNewFolder" Grid.Column="2" Style="{StaticResource FlatButton}" Padding="2,0" ToolTip="Создать папку">
                                <Grid>
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" Foreground="#E0A526" FontSize="14"/>
                                    <TextBlock Text="+" Foreground="#2E9E3E" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>
                    <!-- Ассистенты -->
                    <Border Grid.Row="1" Background="#FFF3CD" BorderBrush="#EBD9A0" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <DockPanel Height="19" Margin="4,0,4,0">
                                <Border DockPanel.Dock="Left" Width="13" Height="13" CornerRadius="7" Background="#2F7FD0" VerticalAlignment="Center">
                                    <TextBlock Text="+" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                </Border>
                                <Button x:Name="btnAssistToggle" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="2,0">
                                    <TextBlock x:Name="txtAssistArrow" Text="&#x2303;" Foreground="#9A8A5A"/>
                                </Button>
                                <TextBlock Text="Ассистенты" FontWeight="Bold" Foreground="#C88A00" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </DockPanel>
                            <DockPanel x:Name="pnlAssist" Height="20" Margin="2,0,4,2">
                                <Border DockPanel.Dock="Left" Background="#F2C94C" Width="18" Height="18" CornerRadius="2">
                                    <TextBlock Text="&#xEA80;" Style="{StaticResource Glyph}" Foreground="#FFFFFF" HorizontalAlignment="Center" FontSize="11"/>
                                </Border>
                                <ToggleButton x:Name="tglOnline" DockPanel.Dock="Left" Margin="6,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                                <Ellipse x:Name="dot" Width="9" Height="9" Fill="#BBBBBB" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="txt" Text="Онлайн статус" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#555"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="dot" Property="Fill" Value="#2DB84D"/>
                                                    <Setter TargetName="txt" Property="Foreground" Value="#222"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <TextBlock x:Name="txtOnlineInfo" Foreground="#9A8A5A" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,2,0"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <TreeView x:Name="tvStorage" Grid.Row="2" BorderThickness="0" Padding="0,2,0,0"
                              ItemContainerStyle="{StaticResource StorageTreeItem}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource StorageTreeItem}">
                                <Grid Height="18" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="14"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphColor}" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="2,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="{Binding Weight}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Count}" Foreground="#2F7FD0" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,2,0">
                                        <TextBlock x:Name="lk" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#2F7FD0" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBlock Text="{Binding Ip}" Foreground="#2F7FD0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Ellipse Grid.Column="3" Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Ip}" Value="">
                                        <Setter TargetName="lk" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Ip}" Value="{x:Null}">
                                        <Setter TargetName="lk" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <!-- ============ Правая часть: вкладки ============ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#F3F3F3" BorderBrush="#CFCFCF" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                        <Button x:Name="btnHome" Style="{StaticResource FlatButton}" Padding="3,1" Margin="0,0,4,0" ToolTip="Обзор хранилища">
                            <TextBlock Text="&#xE8A1;" Style="{StaticResource Glyph}" Foreground="#5A6E83" FontSize="13"/>
                        </Button>
                        <RadioButton x:Name="tabScanner" GroupName="MainTabs" Style="{StaticResource MainTab}" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" Foreground="#2E9E3E" Margin="0,0,6,0"/>
                                <TextBlock Text="Сканер"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="tabView" GroupName="MainTabs" Style="{StaticResource MainTab}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A1;" Style="{StaticResource Glyph}" Foreground="#2B7CD3" Margin="0,0,6,0"/>
                                <TextBlock Text="Просмотр и отчеты"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="tabTables" GroupName="MainTabs" Style="{StaticResource MainTab}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80A;" Style="{StaticResource Glyph}" Foreground="#2B7CD3" Margin="0,0,6,0"/>
                                <TextBlock Text="Табличные отчеты"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="tabSoftware" GroupName="MainTabs" Style="{StaticResource MainTab}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71D;" Style="{StaticResource Glyph}" Foreground="#7A8A99" Margin="0,0,6,0"/>
                                <TextBlock Text="Учет ПО"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="tabLicenses" GroupName="MainTabs" Style="{StaticResource MainTab}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D7;" Style="{StaticResource Glyph}" Foreground="#D4A017" Margin="0,0,6,0"/>
                                <TextBlock Text="Лицензии"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="tabChanges" GroupName="MainTabs" Style="{StaticResource MainTab}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}" Foreground="#2E9E3E" Margin="0,0,6,0"/>
                                <TextBlock Text="Журнал изменений"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">

                    <!-- ======================= СКАНЕР ======================= -->
                    <Grid x:Name="pageScanner">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="210"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#F4F4F4" BorderBrush="#DADADA" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center">
                                <Border BorderBrush="#C9C9C9" BorderThickness="1" Background="White" Height="20" Width="235">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Добавить" Foreground="#A0A0A0" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,6,0"/>
                                        <TextBox x:Name="txtAddTask" Grid.Column="1" BorderThickness="0" Padding="0" VerticalContentAlignment="Center"/>
                                        <Button x:Name="btnAddTask" Grid.Column="2" Style="{StaticResource FlatButton}" Padding="2,0" ToolTip="Добавить задачу (Enter)">
                                            <Border Width="12" Height="12" CornerRadius="6" BorderBrush="#9AA3AD" BorderThickness="1">
                                                <TextBlock Text="+" FontSize="10" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                            </Border>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Button x:Name="btnAddHistory" Style="{StaticResource FlatButton}" Padding="2,0" ToolTip="Последние адреса">
                                    <TextBlock Text="&#x25BE;" Foreground="#555"/>
                                </Button>
                                <TextBlock Text="Примеры: 192.168.1.0/24, 10.0.0.1-50, PC-01" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="150" MinHeight="60"/>
                            </Grid.RowDefinitions>
                            <!-- приветствие -->
                            <Grid x:Name="gridWelcome" Background="White">
                                <StackPanel HorizontalAlignment="Center" Margin="0,36,0,0">
                                    <Button x:Name="btnQuickScan" HorizontalAlignment="Center" Background="#EFEFEF" BorderBrush="#ADADAD" Padding="8,4" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" Foreground="#2E9E3E" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Начать быстрое сканирование" FontWeight="Bold" Foreground="#555" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="сканирует этот компьютер и локальные подсети без дополнительных настроек, или..." Foreground="#555" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                    <StackPanel x:Name="pnlWelcomeHelp">
                                        <TextBlock Text="Добавьте задачи сканирования" FontSize="18" FontWeight="Bold" Foreground="#A9CDEB" HorizontalAlignment="Center" Margin="0,40,0,6"/>
                                        <TextBlock Text="Введите IP-адрес, IP-диапазон или сетевое имя в поле Добавить" Foreground="#444" HorizontalAlignment="Center"/>
                                        <TextBlock Text="или" FontSize="18" FontWeight="Bold" Foreground="#A9CDEB" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                        <TextBlock Text="выберите задачу на боковой панели" Foreground="#444" HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                                            <TextBlock Text="&#xE897;" Style="{StaticResource Glyph}" Foreground="#2F7FD0" Margin="0,0,6,0"/>
                                            <Button x:Name="lnkTaskHelp" Style="{StaticResource LinkButton}" Content="Помощь по добавлению задач"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                            <TextBlock Text="&#xE8E1;" Style="{StaticResource Glyph}" Foreground="#E0A526" Margin="0,0,6,0"/>
                                            <Button x:Name="lnkHideWelcome" Style="{StaticResource LinkButton}" Content="Я это уже знаю, спасибо!"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <!-- задачи -->
                            <DataGrid x:Name="dgTasks" Visibility="Collapsed" IsReadOnly="False" SelectionMode="Extended" RowHeight="22" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="26" CanUserResize="False">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox x:Name="chkAllTasks" IsChecked="True" Margin="2,0,0,0"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Задача" Width="2*" SortMemberPath="Text">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Tag="delete" Style="{StaticResource FlatButton}" Padding="2,0" ToolTip="Удалить задачу">
                                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#D9302C"/>
                                                    </Button>
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="#3A6EA5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="150">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE782;" FontFamily="Segoe MDL2 Assets" Foreground="#1E88E5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Windows (логин)"/>
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding LoginOptions}" SelectedItem="{Binding LoginName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Height="20"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="170">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#E0A526" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Поместить в папку"/>
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding FolderOptions}" SelectedItem="{Binding FolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Height="20"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Состояние" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" Background="#E6E6E6"/>
                            <!-- журнал сканирования -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="#F4F4F4" BorderBrush="#DADADA" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Background="White" BorderBrush="#CFCFCF" BorderThickness="1,2,1,0" Margin="2,2,0,-1" Padding="8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE8A5;" Style="{StaticResource Glyph}" Foreground="#5F6B76" Margin="0,0,5,0" FontSize="12"/>
                                                <TextBlock Text="Журнал сканирования"/>
                                                <TextBlock x:Name="txtLogCount" Text="0" Foreground="#888" Margin="14,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Grid/>
                                    </DockPanel>
                                </Border>
                                <DockPanel Grid.Row="1" Margin="4,0,4,0">
                                    <Button x:Name="btnClearLog" DockPanel.Dock="Right" Style="{StaticResource FlatButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE894;" Style="{StaticResource Glyph}" Foreground="#9AA3AD" Margin="0,0,4,0" FontSize="11"/>
                                            <TextBlock Text="Очистить" Foreground="#555"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="txtLogMessages" Text="Сообщений: 0" Foreground="#555" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ListBox x:Name="lbLog" Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#E6E6E6" ItemContainerStyle="{StaticResource PlainListItem}" VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,1">
                                                <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphColor}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Time}" Foreground="#888" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Text}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>

                        <!-- боковая панель сканера -->
                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1,0,0,0" Background="#FFFFFF">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,4,0,8">
                                    <Border Margin="6,2,6,2" Height="22" Background="#5AA9EA" BorderBrush="#3D8FD8" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" Foreground="#C9F2C9" Margin="0,0,5,0" FontSize="12"/>
                                            <TextBlock Text="Сканер" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="btnStartScan" Margin="6,2,6,0" HorizontalContentAlignment="Stretch" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="#9FD0F5" BorderBrush="#6BAEE3" BorderThickness="1" Padding="6,4">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#8AC5F2"/></Trigger>
                                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Background" Value="#E6E6E6"/><Setter TargetName="Bd" Property="BorderBrush" Value="#D0D0D0"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="glyphStartScan" Text="&#xE768;" Style="{StaticResource Glyph}" Foreground="#3A6EA5" FontSize="12" Margin="2,0,10,0"/>
                                            <StackPanel>
                                                <TextBlock x:Name="txtStartScan" Text="Начать сканирование" FontWeight="Bold" Foreground="#333"/>
                                                <TextBlock x:Name="txtStartScanSub" Text="Нет задач" Foreground="#555"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnScanSettings" Style="{StaticResource PanelButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Foreground="#5F6B76" Margin="0,0,6,0" FontSize="12"/>
                                            <TextBlock Text="Настроить сканер"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnLogins" Style="{StaticResource PanelButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE77B;" Style="{StaticResource Glyph}" Foreground="#5F6B76" Margin="0,0,6,0" FontSize="12"/>
                                            <TextBlock Text="Настроить логины"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnClearTasks" Style="{StaticResource PanelButton}" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE894;" Style="{StaticResource Glyph}" Foreground="#E08A00" Margin="0,0,6,0" FontSize="12"/>
                                            <TextBlock Text="Очистить все"/>
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="Добавить задачу:" Style="{StaticResource SideHeader}" Margin="6,12,6,3"/>
                                    <Button x:Name="btnAddThis" Style="{StaticResource SideButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE80F;" Style="{StaticResource Glyph}" Foreground="#E08A00" Margin="0,0,7,0" FontSize="12"/>
                                            <TextBlock Text="Этот компьютер"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnAddAll" Style="{StaticResource SideButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8F1;" Style="{StaticResource Glyph}" Foreground="#5A6E83" Margin="0,0,7,0" FontSize="12"/>
                                            <TextBlock Text="Все устройства"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnAddSelected" Style="{StaticResource SideButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE762;" Style="{StaticResource Glyph}" Foreground="#2F7FD0" Margin="0,0,7,0" FontSize="12"/>
                                            <TextBlock Text="Выбранные устройства"/>
                                        </StackPanel>
                                    </Button>

                                    <DockPanel Margin="6,14,8,3">
                                        <TextBlock DockPanel.Dock="Right" Text="&#x25BC;" FontSize="9" Foreground="#6D7783" VerticalAlignment="Center"/>
                                        <TextBlock Text="Сети IP" FontWeight="Bold" Foreground="#6D7783"/>
                                    </DockPanel>
                                    <ItemsControl x:Name="icSubnets">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SideButton}" Tag="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" Foreground="#2C7BB6" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="txtNoSubnets" Text="Сети не найдены" Foreground="#666" Margin="12,2,6,0" Visibility="Collapsed"/>

                                    <DockPanel Margin="6,14,8,3">
                                        <TextBlock DockPanel.Dock="Right" Text="&#x25BC;" FontSize="9" Foreground="#6D7783" VerticalAlignment="Center"/>
                                        <TextBlock Text="Active Directory" FontWeight="Bold" Foreground="#6D7783"/>
                                    </DockPanel>
                                    <TextBlock x:Name="txtAdStatus" Text="Домены не найдены" Foreground="#666" Margin="12,2,6,2"/>
                                    <ItemsControl x:Name="icAdDomains">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SideButton}" Tag="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="#2B7CD3" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button x:Name="btnAdConnect" Style="{StaticResource PanelButton}" HorizontalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE716;" Style="{StaticResource Glyph}" Foreground="#3C8D3C" Margin="0,0,6,0" FontSize="12"/>
                                            <TextBlock Text="Подключиться к домену"/>
                                        </StackPanel>
                                    </Button>

                                    <DockPanel Margin="6,14,8,3">
                                        <TextBlock DockPanel.Dock="Right" Text="&#x25BC;" FontSize="9" Foreground="#6D7783" VerticalAlignment="Center"/>
                                        <TextBlock Text="Сохраненные задачи" FontWeight="Bold" Foreground="#6D7783"/>
                                    </DockPanel>
                                    <TextBlock x:Name="txtNoSavedTasks" Text="Нет сохраненных задач" Foreground="#666" Margin="12,2,6,2"/>
                                    <ItemsControl x:Name="icSavedTasks">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SideButton}" Tag="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="#5F6B76" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button x:Name="btnSaveTasks" Style="{StaticResource PanelButton}" HorizontalContentAlignment="Center" IsEnabled="False">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" Foreground="#2F7FD0" Margin="0,0,6,0" FontSize="11"/>
                                            <TextBlock Text="Сохранить текущие задачи"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnOpenTasksFolder" Style="{StaticResource PanelButton}" HorizontalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" Foreground="#E0A526" Margin="0,0,6,0" FontSize="12"/>
                                            <TextBlock Text="Открыть папку задач"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ======================= ПРОСМОТР И ОТЧЕТЫ ======================= -->
                    <Grid x:Name="pageView" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="210"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#F4F4F4" BorderBrush="#DADADA" BorderThickness="0,0,0,1">
                            <DockPanel Margin="6,0,4,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="glyphViewTitle" Style="{StaticResource Glyph}" Foreground="#3A6EA5" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="txtViewTitle" FontWeight="Bold" Foreground="#444" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border x:Name="pnlSnapshots" BorderBrush="#C9C9C9" BorderThickness="1" Background="White" Height="20">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="btnSnapPrev" Style="{StaticResource FlatButton}" Padding="4,0" ToolTip="Предыдущий снимок"><TextBlock Text="&#x2190;" Foreground="#666"/></Button>
                                            <ComboBox x:Name="cbSnapshots" Width="130" BorderThickness="0" Background="White" Height="18" HorizontalContentAlignment="Center"/>
                                            <Button x:Name="btnSnapNext" Style="{StaticResource FlatButton}" Padding="4,0" ToolTip="Следующий снимок"><TextBlock Text="&#x2192;" Foreground="#666"/></Button>
                                            <Button x:Name="btnSnapDelete" Style="{StaticResource FlatButton}" Padding="3,0" ToolTip="Удалить выбранный снимок"><TextBlock Text="&#xE787;" Style="{StaticResource Glyph}" Foreground="#D9302C" FontSize="12"/></Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="140" Margin="0,0,6,0">
                                        <TextBox x:Name="txtCardSearch" Style="{StaticResource SearchBox}"/>
                                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="#9AA3AD" FontSize="11" IsHitTestVisible="False" Margin="4,0,0,0" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="phCardSearch" Text="Поиск..." Foreground="#A0A0A0" IsHitTestVisible="False" Margin="20,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Button x:Name="btnViewCopy" Style="{StaticResource FlatButton}" Padding="3,1" ToolTip="Копировать">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" Foreground="#5F6B76" FontSize="12"/><TextBlock Text=" &#x25BE;" Foreground="#555"/></StackPanel>
                                    </Button>
                                    <Button x:Name="btnViewExport" Style="{StaticResource FlatButton}" Padding="3,1" ToolTip="Экспорт">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}" Foreground="#5F6B76" FontSize="12"/><TextBlock Text=" &#x25BE;" Foreground="#555"/></StackPanel>
                                    </Button>
                                    <Button x:Name="btnPrintReports" Style="{StaticResource FlatButton}">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE749;" Style="{StaticResource Glyph}" Foreground="#5F6B76" FontSize="12" Margin="0,0,5,0"/><TextBlock Text="Отчеты для печати"/></StackPanel>
                                    </Button>
                                </StackPanel>
                                <Grid/>
                            </DockPanel>
                        </Border>
                        <Grid Grid.Row="1" Grid.Column="0" Background="#EBEBEB">
                            <ListBox x:Name="lbCard" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource PlainListItem}"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="White">
                                            <Border x:Name="hdr" Visibility="Collapsed" Background="#DCEBFA" Padding="8,4,8,5" BorderBrush="#C7DDF3" BorderThickness="0,0,0,1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#x25BC;" Foreground="#2F7FD0" FontSize="10" VerticalAlignment="Center" Margin="0,2,7,0"/>
                                                    <TextBlock Text="{Binding Text}" Foreground="#2F7FD0" FontSize="16" FontFamily="Segoe UI"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="grp" Visibility="Collapsed" Background="#F0F0F0" Padding="0,2" BorderBrush="#E6E6E6" BorderThickness="0,1,0,0" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal" Margin="{Binding IndentMargin}">
                                                    <Border Width="9" Height="9" BorderBrush="#8E9AA6" BorderThickness="1" Background="White" Margin="20,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ExpanderText}" FontSize="9" LineHeight="9" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" Foreground="#3A4A5A"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphColor}" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Text}" FontWeight="Bold" Foreground="#6D6D6D" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Grid x:Name="itm" Visibility="Collapsed" Height="19" Cursor="Hand" Background="Transparent">
                                                <StackPanel Orientation="Horizontal" Margin="{Binding IndentMargin}">
                                                    <Border Width="9" Height="9" BorderBrush="#8E9AA6" BorderThickness="1" Background="White" Margin="20,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ExpanderText}" FontSize="9" LineHeight="9" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" Foreground="#3A4A5A"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphColor}" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Text}" FontWeight="Bold" Foreground="#6D6D6D" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Value}" Foreground="#333" VerticalAlignment="Center" Margin="22,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid x:Name="prp" Visibility="Collapsed" MinHeight="17" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="230"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Text}" Foreground="#2F7FD0" Margin="{Binding IndentMargin}" Padding="32,1,6,1" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,1,6,1">
                                                    <Ellipse x:Name="dot" Width="8" Height="8" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock x:Name="mk" FontFamily="Segoe MDL2 Assets" FontSize="10" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock x:Name="val" Text="{Binding Value}" TextWrapping="NoWrap"/>
                                                    <TextBlock Text="{Binding Value2}" Foreground="#2F7FD0" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="emp" Visibility="Collapsed" Text="{Binding Text}" Foreground="#888" Margin="32,6,6,6"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Header"><Setter TargetName="hdr" Property="Visibility" Value="Visible"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Group"><Setter TargetName="grp" Property="Visibility" Value="Visible"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Item"><Setter TargetName="itm" Property="Visibility" Value="Visible"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Prop"><Setter TargetName="prp" Property="Visibility" Value="Visible"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Empty"><Setter TargetName="emp" Property="Visibility" Value="Visible"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Mark}" Value="yes">
                                                <Setter TargetName="mk" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="mk" Property="Text" Value="&#xE73E;"/>
                                                <Setter TargetName="mk" Property="Foreground" Value="#2E9E3E"/>
                                                <Setter TargetName="val" Property="Foreground" Value="#666666"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mark}" Value="no">
                                                <Setter TargetName="mk" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="mk" Property="Text" Value="&#xE711;"/>
                                                <Setter TargetName="mk" Property="Foreground" Value="#D9302C"/>
                                                <Setter TargetName="val" Property="Foreground" Value="#666666"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mark}" Value="online">
                                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="dot" Property="Fill" Value="#2DB84D"/>
                                                <Setter TargetName="val" Property="Foreground" Value="#666666"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mark}" Value="offline">
                                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="dot" Property="Fill" Value="#AAAAAA"/>
                                                <Setter TargetName="val" Property="Foreground" Value="#666666"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <DataGrid x:Name="dgFolder" Visibility="Collapsed" AutoGenerateColumns="True"/>
                            <StackPanel x:Name="pnlViewEmpty" Visibility="Collapsed">
                                <TextBlock x:Name="txtViewEmptyTitle" Text="Не выбрано ни одно устройство" Style="{StaticResource EmptyTitle}"/>
                                <TextBlock x:Name="txtViewEmptyText" Text="Выберите устройство в дереве слева или отсканируйте сеть на вкладке «Сканер»." Style="{StaticResource EmptyText}"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1,0,0,0" Background="White">
                            <DockPanel>
                                <CheckBox x:Name="chkMultiCat" DockPanel.Dock="Top" Content="Несколько категорий" FontWeight="Bold" Foreground="#6D7783" Margin="10,8,6,4"/>
                                <Button x:Name="btnAddNote" DockPanel.Dock="Bottom" Style="{StaticResource PanelButton}" Margin="6,4,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70B;" Style="{StaticResource Glyph}" Foreground="#D4A017" Margin="0,0,6,0" FontSize="12"/>
                                        <TextBlock Text="Добавить записку"/>
                                    </StackPanel>
                                </Button>
                                <ListBox x:Name="lbCategories" BorderThickness="0" ItemContainerStyle="{StaticResource SideListItem}" ItemTemplate="{StaticResource SideItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ======================= ТАБЛИЧНЫЕ ОТЧЕТЫ ======================= -->
                    <Grid x:Name="pageTables" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="210"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#F4F4F4" BorderBrush="#DADADA" BorderThickness="0,0,0,1">
                            <DockPanel Margin="6,0,4,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="glyphTablesScope" Style="{StaticResource Glyph}" Foreground="#3A6EA5" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="txtTablesScope" FontWeight="Bold" Foreground="#444" Margin="0,0,16,0"/>
                                    <TextBlock x:Name="txtTablesRows" FontWeight="Bold" Foreground="#666"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="160" Margin="0,0,6,0">
                                        <TextBox x:Name="txtTableSearch" Style="{StaticResource SearchBox}"/>
                                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="#9AA3AD" FontSize="11" IsHitTestVisible="False" Margin="4,0,0,0" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="phTableSearch" Text="Поиск..." Foreground="#A0A0A0" IsHitTestVisible="False" Margin="20,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Button x:Name="btnTableCopy" Style="{StaticResource FlatButton}" Padding="3,1" ToolTip="Копировать">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" Foreground="#5F6B76" FontSize="12"/><TextBlock Text=" &#x25BE;" Foreground="#555"/></StackPanel>
                                    </Button>
                                    <Button x:Name="btnTableExport" Style="{StaticResource FlatButton}" Padding="3,1" ToolTip="Экспорт">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}" Foreground="#5F6B76" FontSize="12"/><TextBlock Text=" &#x25BE;" Foreground="#555"/></StackPanel>
                                    </Button>
                                </StackPanel>
                                <Grid/>
                            </DockPanel>
                        </Border>
                        <Grid Grid.Row="1" Grid.Column="0" Background="#EBEBEB">
                            <DataGrid x:Name="dgReport" AutoGenerateColumns="True" Visibility="Collapsed" CanUserSortColumns="True" CanUserReorderColumns="True"/>
                            <StackPanel x:Name="pnlTablesEmpty">
                                <TextBlock Text="Не выбран ни один объект" Style="{StaticResource EmptyTitle}"/>
                                <TextBlock Text="Выберите один из шаблонов на боковой панели" Style="{StaticResource EmptyText}"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1,0,0,0" Background="White">
                            <ListBox x:Name="lbTemplates" BorderThickness="0" ItemContainerStyle="{StaticResource SideListItem}" ItemTemplate="{StaticResource SideItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </Border>
                    </Grid>

                    <!-- ======================= УЧЕТ ПО ======================= -->
                    <Grid x:Name="pageSoftware" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="210"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#F4F4F4" BorderBrush="#DADADA" BorderThickness="0,0,0,1">
                            <DockPanel Margin="6,0,4,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE71C;" Style="{StaticResource Glyph}" Foreground="#7A8A99" Margin="0,0,4,0" FontSize="12"/>
                                    <ComboBox x:Name="cbSwFilter" Width="150" Height="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="&#xE7B3;" Style="{StaticResource Glyph}" Foreground="#9AA3AD" Margin="0,0,4,0" FontSize="12"/>
                                    <TextBlock x:Name="txtSwVisible" Text="Видимые: 0 из 0" Foreground="#444" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="160" Margin="0,0,6,0">
                                        <TextBox x:Name="txtSwSearch" Style="{StaticResource SearchBox}"/>
                                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="#9AA3AD" FontSize="11" IsHitTestVisible="False" Margin="4,0,0,0" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="phSwSearch" Text="Поиск..." Foreground="#A0A0A0" IsHitTestVisible="False" Margin="20,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Button x:Name="btnSwExport" Style="{StaticResource FlatButton}" Padding="3,1" ToolTip="Экспорт">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}" Foreground="#5F6B76" FontSize="12"/><TextBlock Text=" &#x25BE;" Foreground="#555"/></StackPanel>
                                    </Button>
                                </StackPanel>
                                <Grid/>
                            </DockPanel>
                        </Border>
                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="80"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="*" MinHeight="80"/>
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="dgSoftware" RowHeight="26" GridLinesVisibility="Horizontal" CanUserSortColumns="True" SelectionMode="Extended">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Название и версия" Width="*" SortMemberPath="Name" CanUserSort="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphColor}" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                                        <TextBlock Text="{Binding VersionCountText}" Foreground="#2F7FD0" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-4"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock>
                                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                                            <Run Text="{Binding Version, Mode=OneWay}" Foreground="#909090"/>
                                                        </TextBlock>
                                                        <TextBlock x:Name="pub" Text="{Binding PublisherText}" Foreground="#A0A0A0" FontSize="10"/>
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding PublisherText}" Value=""><Setter TargetName="pub" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="150">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#666"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Тип" Width="50" SortMemberPath="TypeText">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="8" Height="8" Fill="{Binding TypeColor}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding TypeText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Копии" Binding="{Binding Copies}" Width="60">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#2F7FD0"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Лицензирование" Binding="{Binding License}" Width="160">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#888"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                <Setter Property="Background" Value="#F4F4F4"/>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid x:Name="dgSwAlt" AutoGenerateColumns="True" Visibility="Collapsed" CanUserSortColumns="True"/>
                            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" Background="#E6E6E6"/>
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="#F4F4F4" BorderBrush="#DADADA" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="tabSwInstalls" GroupName="SwBottom" Style="{StaticResource MainTab}" IsChecked="True">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="#2F7FD0" FontSize="11" Margin="0,0,5,0"/>
                                                <TextBlock Text="Установки"/>
                                                <TextBlock x:Name="txtSwInstallsCount" Foreground="#888" Margin="24,0,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="tabSwLicensing" GroupName="SwBottom" Style="{StaticResource MainTab}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8D7;" Style="{StaticResource Glyph}" Foreground="#D4A017" FontSize="11" Margin="0,0,5,0"/>
                                                <TextBlock Text="Лицензирование"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                                <DockPanel Grid.Row="1" Margin="6,0,4,0">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="glyphSwSelected" Style="{StaticResource Glyph}" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="txtSwSelected" FontWeight="Bold"/>
                                        <TextBlock x:Name="txtSwSelectedPub" Foreground="#888" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="cbInstallFilter" Width="150" Height="20" Margin="0,0,6,0"/>
                                        <Grid Width="180">
                                            <TextBox x:Name="txtInstallSearch" Style="{StaticResource SearchBox}"/>
                                            <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="#9AA3AD" FontSize="11" IsHitTestVisible="False" Margin="4,0,0,0" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="phInstallSearch" Text="Компьютеры, версии..." Foreground="#A0A0A0" IsHitTestVisible="False" Margin="20,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                    <Grid/>
                                </DockPanel>
                                <DataGrid x:Name="dgInstalls" Grid.Row="2" AutoGenerateColumns="True" CanUserSortColumns="True"/>
                                <StackPanel x:Name="pnlSwLicensing" Grid.Row="2" Visibility="Collapsed" Background="White">
                                    <TextBlock x:Name="txtSwLicensing" Margin="12,10,12,4" TextWrapping="Wrap"/>
                                    <Button x:Name="btnSwCreateLicense" Style="{StaticResource PanelButton}" HorizontalAlignment="Left" Margin="12,4,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" Foreground="#2E9E3E" Margin="0,0,6,0" FontSize="11"/>
                                            <TextBlock Text="Создать лицензию для этого ПО"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="pnlSwNoSelection" Grid.Row="1" Grid.RowSpan="2" Background="#EBEBEB">
                                    <TextBlock Text="Не выбрано ни одно ПО" Style="{StaticResource EmptyTitle}"/>
                                    <TextBlock Text="Выберите одну или несколько единиц ПО." Style="{StaticResource EmptyText}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1,0,0,0" Background="White">
                            <ListBox x:Name="lbSwViews" BorderThickness="0" ItemContainerStyle="{StaticResource SideListItem}" ItemTemplate="{StaticResource SideItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </Border>
                    </Grid>

                    <!-- ======================= ЛИЦЕНЗИИ ======================= -->
                    <Grid x:Name="pageLicenses" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="210"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#F4F4F4" BorderBrush="#DADADA" BorderThickness="0,0,0,1">
                            <DockPanel Margin="6,0,4,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8D7;" Style="{StaticResource Glyph}" Foreground="#D4A017" Margin="0,0,5,0" FontSize="12"/>
                                    <TextBlock x:Name="txtLicVisible" Text="Видимые: 0 из 0" Foreground="#444" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="btnLicExport" Style="{StaticResource FlatButton}" Padding="3,1" ToolTip="Экспорт">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}" Foreground="#5F6B76" FontSize="12"/><TextBlock Text=" &#x25BE;" Foreground="#555"/></StackPanel>
                                    </Button>
                                </StackPanel>
                                <Grid/>
                            </DockPanel>
                        </Border>
                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="100"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="*" MinHeight="100"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="185"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- лицензии: слева фильтр по ПО -->
                            <Border Grid.Row="0" Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <Button x:Name="btnCreateLicense" DockPanel.Dock="Top" Margin="4,4,4,4" Height="26" Background="#EAEAEA" BorderBrush="#BDBDBD" Cursor="Hand" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8D7;" Style="{StaticResource Glyph}" Foreground="#D4A017" Margin="4,0,6,0"/>
                                            <TextBlock Text="Создать лицензию" FontWeight="Bold" Foreground="#555"/>
                                        </StackPanel>
                                    </Button>
                                    <Grid DockPanel.Dock="Top" Margin="4,0,4,4">
                                        <TextBox x:Name="txtLicSearch" Style="{StaticResource SearchBox}"/>
                                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="#9AA3AD" FontSize="11" IsHitTestVisible="False" Margin="4,0,0,0" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="phLicSearch" Text="Найти в лицензионном ПО..." Foreground="#A0A0A0" IsHitTestVisible="False" Margin="20,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ListBox x:Name="lbLicSoftware" BorderThickness="0" ItemContainerStyle="{StaticResource PlainListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="20" Margin="4,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphColor}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="#2F7FD0" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="#FAFAFA" BorderBrush="#DEDEDE" BorderThickness="0,0,0,1" Height="22">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Имя лицензии" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Цена" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Установлено" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="Мест" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="Статус" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="bdUnboundStrip" Grid.Row="1" Background="#FFF3B0" BorderBrush="#EAD98A" BorderThickness="0,0,0,1" Height="22" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Margin="6,0">
                                        <TextBlock Text="&#xE8D7;" Style="{StaticResource Glyph}" Foreground="#C88A00" Margin="0,0,6,0" FontSize="12"/>
                                        <TextBlock x:Name="txtUnboundStrip" Text="Непривязанные ключи: 0" FontWeight="Bold" Foreground="#555" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Grid Grid.Row="2" Background="#EBEBEB">
                                    <DataGrid x:Name="dgLicenses" HeadersVisibility="None" GridLinesVisibility="Horizontal" RowHeight="22" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" Foreground="#D4A017" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Software}" Foreground="#888" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Binding="{Binding Price}" Width="80"/>
                                            <DataGridTextColumn Binding="{Binding Installed}" Width="90"/>
                                            <DataGridTextColumn Binding="{Binding Seats}" Width="90"/>
                                            <DataGridTemplateColumn Width="110">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel x:Name="pnlNoLicenses" Visibility="Collapsed" IsHitTestVisible="False">
                                        <TextBlock Text="В базе данных нет лицензий" Style="{StaticResource EmptyTitle}"/>
                                        <TextBlock Text="Создайте лицензию." Style="{StaticResource EmptyText}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <GridSplitter Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" Background="#E6E6E6"/>
                            <!-- непривязанные ключи -->
                            <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" Background="#F4F4F4" BorderBrush="#DADADA" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" Margin="6,0">
                                        <TextBlock Text="&#xE8D7;" Style="{StaticResource Glyph}" Foreground="#C88A00" Margin="0,0,6,0" FontSize="12"/>
                                        <TextBlock Text="Непривязанные ключи" FontWeight="Bold" Foreground="#444" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" Foreground="#2F7FD0" Margin="6,0,0,0" FontSize="11" ToolTip="Ключи продуктов, найденные при сканировании и не привязанные ни к одной лицензии"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                                    <ListBox x:Name="lbKeyProducts" BorderThickness="0" ItemContainerStyle="{StaticResource PlainListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="20" Margin="4,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphColor}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="#2F7FD0" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <DataGrid x:Name="dgKeys" Grid.Row="1" Grid.Column="1" GridLinesVisibility="Horizontal" CanUserSortColumns="True">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Лицензионный ключ" Width="260" SortMemberPath="Key">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" Foreground="#D4A017" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Key}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Компьютер" Width="200" SortMemberPath="DeviceName">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Ip}" Foreground="#2F7FD0" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        <TextBlock Text="{Binding DeviceName}" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="ПО" Binding="{Binding Product}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#888"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Действие" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource LinkButton}" Content="Привязать к лицензии" Tag="bindkey" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1,0,0,0" Background="White">
                            <ListBox x:Name="lbLicViews" BorderThickness="0" ItemContainerStyle="{StaticResource SideListItem}" ItemTemplate="{StaticResource SideItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </Border>
                    </Grid>

                    <!-- ======================= ЖУРНАЛ ИЗМЕНЕНИЙ ======================= -->
                    <Grid x:Name="pageChanges" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="210"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#F4F4F4" BorderBrush="#DADADA" BorderThickness="0,0,0,1">
                            <DockPanel Margin="6,0,4,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="glyphChangesScope" Style="{StaticResource Glyph}" Foreground="#3A6EA5" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="txtChangesScope" FontWeight="Bold" Foreground="#444" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <Border BorderBrush="#C9C9C9" BorderThickness="1" Background="White" Height="20" Padding="4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="с" Foreground="#888" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <DatePicker x:Name="dpFrom" Width="105" BorderThickness="0" Padding="0" VerticalContentAlignment="Center"/>
                                            <TextBlock Text="по" Foreground="#888" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                            <DatePicker x:Name="dpTo" Width="105" BorderThickness="0" Padding="0" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <CheckBox x:Name="chkChangesOnlyChanged" Content="Только с изменениями" Margin="10,0,0,0" IsChecked="True" ToolTip="Скрывать категории без изменений"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="150" Margin="0,0,6,0">
                                        <TextBox x:Name="txtChangesSearch" Style="{StaticResource SearchBox}"/>
                                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="#9AA3AD" FontSize="11" IsHitTestVisible="False" Margin="4,0,0,0" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="phChangesSearch" Text="Поиск..." Foreground="#A0A0A0" IsHitTestVisible="False" Margin="20,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Button x:Name="btnChangesExport" Style="{StaticResource FlatButton}" Padding="3,1" ToolTip="Экспорт">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}" Foreground="#5F6B76" FontSize="12"/><TextBlock Text=" &#x25BE;" Foreground="#555"/></StackPanel>
                                    </Button>
                                </StackPanel>
                                <Grid/>
                            </DockPanel>
                        </Border>
                        <Grid Grid.Row="1" Grid.Column="0" Background="#EBEBEB">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="bdChangesRefresh" Background="#BFE0FA" BorderBrush="#9CCBF2" BorderThickness="0,0,0,1" Height="22" Cursor="Hand" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="6,0">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" Foreground="#2F7FD0" Margin="0,0,6,0" FontSize="12"/>
                                    <TextBlock Text="Обновить отчет — кликните здесь или нажмите F5" Foreground="#2F7FD0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <DataGrid x:Name="dgChanges" Grid.Row="1" Visibility="Collapsed" CanUserSortColumns="True" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" SortMemberPath="DateSort" Width="120"/>
                                    <DataGridTemplateColumn Header="Устройство" Width="150" SortMemberPath="Device">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Ip}" Foreground="#2F7FD0" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Device}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Категория" Width="150" SortMemberPath="Category">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphColor}" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Category}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Изменение" Width="100" SortMemberPath="Change">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ChangeGlyph}" Foreground="{Binding ChangeColor}" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Change}" Foreground="{Binding ChangeColor}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Элемент" Binding="{Binding Item}" Width="2*"/>
                                    <DataGridTextColumn Header="Было" Binding="{Binding Old}" Width="*">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#999"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Стало" Binding="{Binding New}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="pnlChangesEmpty" Grid.Row="1">
                                <TextBlock x:Name="txtChangesEmptyTitle" Text="Не выбрана ни одна категория" Style="{StaticResource EmptyTitle}"/>
                                <TextBlock x:Name="txtChangesEmptyText" Text="Выберите одну или несколько категорий на боковой панели для обнаружения изменений." Style="{StaticResource EmptyText}"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1,0,0,0" Background="White">
                            <ListBox x:Name="lbChangeCats" BorderThickness="0" ItemContainerStyle="{StaticResource SideListItem}" ItemTemplate="{StaticResource SideCheckTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===================== Строка состояния ===================== -->
        <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#D6D6D6" BorderThickness="0,1,0,0">
            <DockPanel Margin="6,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE977;" Style="{StaticResource Glyph}" Foreground="#3A6EA5" FontSize="12" Margin="0,0,5,0"/>
                    <TextBlock x:Name="txtStatDevices" Text="0" Margin="0,0,14,0" ToolTip="Устройств в хранилище"/>
                    <Ellipse Width="8" Height="8" Fill="#2DB84D" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtStatOnline" Text="0" Margin="0,0,14,0" ToolTip="Устройств в сети"/>
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" Foreground="#E0A526" FontSize="12" Margin="0,0,5,0"/>
                    <TextBlock x:Name="txtStatFolders" Text="0" ToolTip="Папок"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar x:Name="pbScan" Width="140" Height="10" Visibility="Collapsed" Margin="0,0,8,0"/>
                    <TextBlock x:Name="txtStatScan" Foreground="#555"/>
                </StackPanel>
                <Grid/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
